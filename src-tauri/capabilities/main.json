{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only Tala's bundled main window can use validated collection commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "allow-dispatch",
    "allow-pick-file",
    "allow-save-file",
    "allow-open-external"
  ]
}
